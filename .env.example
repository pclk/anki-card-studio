# Copy to .env.local for local development. On Vercel, set these in Project Settings -> Environment Variables
# (DATABASE_URL is added automatically when the Neon integration is connected to the project).

# Neon Postgres (pooled connection string)
DATABASE_URL=

# Auth.js: a random secret (run `npx auth secret` or `openssl rand -base64 32`)
AUTH_SECRET=

# GitHub OAuth app (github.com/settings/developers -> New OAuth App)
#   Homepage URL:            https://<your-domain>
#   Authorization callback:  https://<your-domain>/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# GitHub usernames allowed to sign in (comma or space separated). Empty = nobody.
ACS_ALLOWED_GITHUB=pclk

# Local development / tests only: skip GitHub and act as this user. Ignored on Vercel.
# ACS_INSECURE_DEV_USER=dev
# Local development without Neon: keep the database in this folder (PGlite). Ignored on Vercel.
# ACS_PGLITE_DIR=./.data/pglite
