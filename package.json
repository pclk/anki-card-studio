{
  "name": "anki-card-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Anki Card Studio as a hosted web app: review AI-made Anki cards from any device.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test scripts/*.test.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "sync:sanitizer": "node scripts/embed-sanitizer.mjs",
    "test:local": "python3 scripts/local_test.py && python3 scripts/review_local_test.py",
    "test:coverage": "node --import tsx --experimental-test-coverage --test scripts/*.test.ts",
    "build:studio": "node scripts/build-studio.mjs && node scripts/embed-sanitizer.mjs",
    "test:e2e": "playwright test",
    "test:postgres": "tsx scripts/postgres.integration.ts && tsx scripts/review-postgres.integration.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.1",
    "dompurify": "^3.4.18",
    "htmlparser2": "^10.1.0",
    "ipaddr.js": "^2.5.0",
    "next": "^16.4.6",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "undici": "^7.30.2",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/ws": "^8.18.2",
    "jsdom": "^31.0.1",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
